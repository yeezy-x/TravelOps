    },
    "dependencies": {
        "@prisma/orm-postgres": "8.0.0-rc.22",
        "@repo/shared": "workspace:*",
        "bcryptjs": "^3.0.3",
        "dotenv": "^18.0.9",
        "tsx": "^4.23.15"
    },
    "devDependencies": {
        "@prisma/cli-engine": "0.9.0",
        "@types/node": "^26.6.6",
        "prisma": "8.0.0-rc.30"
    }
}